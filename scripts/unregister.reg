Windows Registry Editor Version 5.00

; Remove Windows Credential Provider registration
[-HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Providers\{3A4E2F6C-81D5-4F8A-9A8E-2B6C7D8E9F01}]

; Remove COM registration
[-HKEY_CLASSES_ROOT\CLSID\{3A4E2F6C-81D5-4F8A-9A8E-2B6C7D8E9F01}]
